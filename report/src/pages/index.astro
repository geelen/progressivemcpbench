---
import ResultsTable from "../components/ResultsTable";
import BenchmarkChart from "../components/BenchmarkChart";
import ChartsContainer from "../components/ChartsContainer";
import type { ReportJson } from "../types/report";

import reportData from "../../../data/reports/report.json";

const report = reportData as ReportJson;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Progressive MCP Bench Results</title>
    <style>
      * {
        box-sizing: border-box;
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen,
          Ubuntu, Cantarell, sans-serif;
        max-width: 1400px;
        margin: 0 auto;
        padding: 20px;
        background-color: #fefefe;
        color: #333;
      }
      h1 {
        margin-bottom: 8px;
      }
      .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
      }
      .header h1 {
        margin: 0;
      }
      .github-link {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #333;
        text-decoration: none;
        font-size: 14px;
        padding: 8px 12px;
        border: 1px solid #ddd;
        border-radius: 6px;
        transition: background-color 0.2s;
      }
      .github-link:hover {
        background-color: #f5f5f5;
      }
      .github-link svg {
        width: 20px;
        height: 20px;
      }
      h2 {
        margin-top: 48px;
        margin-bottom: 16px;
        font-size: 20px;
        color: #444;
        border-bottom: 1px solid #eee;
        padding-bottom: 8px;
      }
      .meta {
        color: #666;
        font-size: 14px;
        margin-bottom: 24px;
      }
      .summary {
        display: flex;
        gap: 24px;
        margin-bottom: 32px;
        flex-wrap: wrap;
      }
      .stat {
        background: #f5f5f5;
        padding: 16px 24px;
        border-radius: 8px;
      }
      .stat-label {
        font-size: 12px;
        text-transform: uppercase;
        color: #666;
        margin-bottom: 4px;
      }
      .stat-value {
        font-size: 24px;
        font-weight: bold;
      }
      .section-intro {
        font-size: 14px;
        color: #666;
        margin-bottom: 24px;
        max-width: 800px;
        line-height: 1.5;
      }
      details {
        margin-top: 48px;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 0;
      }
      summary {
        padding: 16px 20px;
        cursor: pointer;
        font-weight: 600;
        background: #f5f5f5;
        border-radius: 8px;
      }
      details[open] summary {
        border-radius: 8px 8px 0 0;
        border-bottom: 1px solid #ddd;
      }
      .details-content {
        padding: 20px;
      }
    </style>
  </head>
  <body>
    <div class="header">
      <h1>Progressive MCP Bench Results</h1>
      <a href="https://github.com/geelen/progressivemcpbench" class="github-link" target="_blank" rel="noopener">
        <svg viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
        </svg>
        GitHub
      </a>
    </div>
    <p class="meta">
      Generated: {new Date(report.generatedAt).toLocaleString()}
    </p>

    <div class="summary">
      <div class="stat">
        <div class="stat-label">Total Runs</div>
        <div class="stat-value">{report.runs.length}</div>
      </div>
      <div class="stat">
        <div class="stat-label">Models</div>
        <div class="stat-value">{report.dimensions.models.length}</div>
      </div>
      <div class="stat">
        <div class="stat-label">Strategies</div>
        <div class="stat-value">{report.dimensions.strategies.length}</div>
      </div>
    </div>

    <ChartsContainer
      client:load
      runs={report.runs}
      models={report.dimensions.models}
      strategies={report.dimensions.strategies}
    />

    <details>
      <summary>Raw Data & Detailed Charts</summary>
      <div class="details-content">
        <BenchmarkChart
          client:load
          runs={report.runs}
          models={report.dimensions.models}
          strategies={report.dimensions.strategies}
        />

        <ResultsTable
          client:load
          runs={report.runs}
          models={report.dimensions.models}
          strategies={report.dimensions.strategies}
        />
      </div>
    </details>
  </body>
</html>
