---
import ResultsTable from "../components/ResultsTable";
import BenchmarkChart from "../components/BenchmarkChart";
import ChartsContainer from "../components/ChartsContainer";
import type { ReportJson } from "../types/report";

import reportData from "../../../data/reports/report.json";

const report = reportData as ReportJson;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Progressive MCP Bench Results</title>
    <style>
      * {
        box-sizing: border-box;
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen,
          Ubuntu, Cantarell, sans-serif;
        max-width: 1400px;
        margin: 0 auto;
        padding: 20px;
        background-color: #fefefe;
        color: #333;
      }
      h1 {
        margin-bottom: 8px;
      }
      h2 {
        margin-top: 48px;
        margin-bottom: 16px;
        font-size: 20px;
        color: #444;
        border-bottom: 1px solid #eee;
        padding-bottom: 8px;
      }
      .meta {
        color: #666;
        font-size: 14px;
        margin-bottom: 24px;
      }
      .summary {
        display: flex;
        gap: 24px;
        margin-bottom: 32px;
        flex-wrap: wrap;
      }
      .stat {
        background: #f5f5f5;
        padding: 16px 24px;
        border-radius: 8px;
      }
      .stat-label {
        font-size: 12px;
        text-transform: uppercase;
        color: #666;
        margin-bottom: 4px;
      }
      .stat-value {
        font-size: 24px;
        font-weight: bold;
      }
      .section-intro {
        font-size: 14px;
        color: #666;
        margin-bottom: 24px;
        max-width: 800px;
        line-height: 1.5;
      }
      details {
        margin-top: 48px;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 0;
      }
      summary {
        padding: 16px 20px;
        cursor: pointer;
        font-weight: 600;
        background: #f5f5f5;
        border-radius: 8px;
      }
      details[open] summary {
        border-radius: 8px 8px 0 0;
        border-bottom: 1px solid #ddd;
      }
      .details-content {
        padding: 20px;
      }
    </style>
  </head>
  <body>
    <h1>Progressive MCP Bench Results</h1>
    <p class="meta">
      Generated: {new Date(report.generatedAt).toLocaleString()}
    </p>

    <div class="summary">
      <div class="stat">
        <div class="stat-label">Total Runs</div>
        <div class="stat-value">{report.runs.length}</div>
      </div>
      <div class="stat">
        <div class="stat-label">Models</div>
        <div class="stat-value">{report.dimensions.models.length}</div>
      </div>
      <div class="stat">
        <div class="stat-label">Strategies</div>
        <div class="stat-value">{report.dimensions.strategies.length}</div>
      </div>
    </div>

    <ChartsContainer
      client:load
      runs={report.runs}
      models={report.dimensions.models}
      strategies={report.dimensions.strategies}
    />

    <details>
      <summary>Raw Data & Detailed Charts</summary>
      <div class="details-content">
        <BenchmarkChart
          client:load
          runs={report.runs}
          models={report.dimensions.models}
          strategies={report.dimensions.strategies}
        />

        <ResultsTable
          client:load
          runs={report.runs}
          models={report.dimensions.models}
          strategies={report.dimensions.strategies}
        />
      </div>
    </details>
  </body>
</html>
